# ---- Core
NODE_ENV=development
PORT=4173
DATABASE_URL=postgres://lawyerup:lawyerup@localhost:5432/lawyerup
TEST_DATABASE_URL=postgres://lawyerup:lawyerup@localhost:5432/lawyerup_test
# Generate with: openssl rand -hex 32   (required in production)
JWT_SECRET=change-me
SESSION_DAYS=7

# ---- Business rules
PLATFORM_FEE_BPS=1000          # 1000 = 10% service fee
BOOKING_HOLD_MINUTES=10        # slot held while the client pays
FREE_CANCEL_HOURS=4            # full refund if the client cancels at least this early (else 50%)
MIN_LEAD_MINUTES=60            # earliest bookable slot from now
BOOKING_HORIZON_DAYS=30
DEFAULT_CITY=mumbai
REQUIRE_KYC_FOR_BOOKING=true

# ---- Payments: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- OTP: console (prints code, dev only) | msg91
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Identity: sandbox (collects nothing). A real Aadhaar/DigiLocker partner is a later milestone.
KYC_PROVIDER=sandbox

# ---- Video: jitsi | none
VIDEO_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
